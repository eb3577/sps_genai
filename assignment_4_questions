import torch
#question 6
# Create a tensor with gradient tracking enabled.
x = torch.tensor([2.0], requires_grad=False)

# Define y = x² + 3x.
y = x**2 + 3 * x

# Calculate the gradient.
y.backward()

print("x.grad =", x.grad)

